{
  "name": "obsidian-crdt-sync",
  "version": "1.0.0",
  "main": "dist/main.js",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc -v && vite build --mode production && node -e \"require('fs').copyFileSync('manifest.json', 'dist/manifest.json')\"",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && wdio run wdio.conf.mts"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "html5-qrcode": "^2.3.8",
    "qrcode": "^1.5.3",
    "y-codemirror.next": "^0.3.4",
    "yjs": "^13.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/qrcode": "^1.5.5",
    "@wdio/cli": "^9.30.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "fake-indexeddb": "^5.0.2",
    "jsdom": "^24.0.0",
    "obsidian": "latest",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^1.3.1",
    "wdio-obsidian-reporter": "^3.1.1",
    "wdio-obsidian-service": "^3.1.1"
  }
}
