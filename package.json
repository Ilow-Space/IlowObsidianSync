{
  "name": "obsidian-crdt-sync",
  "version": "1.0.0",
  "main": "dist/main.js",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc -v && vite build --mode production && node -e \"require('fs').copyFileSync('manifest.json', 'dist/manifest.json')\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "dry": "jscpd src/",
    "compliance": "npm run lint && npm run dry",
    "test": "vitest run",
    "test:compliance": "npm run typecheck && npm run lint:fix && npm run dry && vitest run tests/6_Compliance.test.ts",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && wdio run wdio.conf.mts",
    "test:all": "npm run typecheck && npm run lint:fix && npm run dry && npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "html5-qrcode": "^2.3.8",
    "qrcode": "^1.5.3",
    "y-codemirror.next": "^0.3.4",
    "yjs": "^13.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/qrcode": "^1.5.5",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@wdio/cli": "^9.30.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "fake-indexeddb": "^5.0.2",
    "jscpd": "^5.0.15",
    "jsdom": "^24.0.0",
    "obsidian": "latest",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^1.3.1",
    "wdio-obsidian-reporter": "^3.1.1",
    "wdio-obsidian-service": "^3.1.1"
  }
}