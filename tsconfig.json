{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@domain/*": ["src/1_Domain/*"],
      "@application/*": ["src/2_Application/*"],
      "@infrastructure/*": ["src/3_Infrastructure/*"],
      "@presentation/*": ["src/4_Presentation/*"]
    }
  },
  "include": ["src/**/*"]
}
